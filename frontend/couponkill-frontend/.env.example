# 复制为 .env.local 覆盖本地配置
# API 基址：
# - 留空 = 同源相对路径 /api/v1/**（开发/预览走 Vite proxy；生产由同域网关/Ingress 转发 /api/**，无需 CORS）
# - 跨域时填网关源，如 https://gw.example.com（不要带 /api/v1，service 层已写全 /api/v1/...；
#   跨域需要网关 CK_GATEWAY_CORS_ORIGINS 放行前端源）
VITE_API_BASE_URL=
# 仅 npm run dev / npm run preview 使用：代理目标（网关地址，默认 :8088）
VITE_PROXY_TARGET=http://localhost:8088
# 是否在登录页展示并预填演示账号 demo/demo1234（npm run dev 默认开启；生产构建需显式 true，仅限公开演示站）
# VITE_SHOW_DEMO_ACCOUNT=false
