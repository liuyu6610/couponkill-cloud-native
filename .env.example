# =============================================================================
# 本地联调配置（复制为 .env 后按需修改；.env 已被 gitignore，切勿提交）
#
#   docker compose up -d                       # 只起 PostgreSQL / Redis / Kafka
#   docker compose --profile app up -d --build # 连 5 个 Go 服务一起起
#   pwsh -File scripts/dev-up.ps1              # 基础设施在容器里，5 个服务在宿主机进程里
#
# docker compose 读 .env 做变量替换；scripts/dev-up.ps1 把本文件里的 CK_* 导出为服务进程的环境变量。
# 下面的取值全是「开发默认值」，与 internal/platform/config 里的内置默认值一致；
# 它们是公开的，CK_ENV=prod 的服务会拒绝它们——生产密钥走 K8s Secret（见 charts/couponkill/README.md）。
# =============================================================================

# --- 运行环境 ----------------------------------------------------------------
# dev | prod。prod 下服务拒绝开发默认密钥与 CK_SEED_DEMO=true。
CK_ENV=dev
# debug | info | warn | error
CK_LOG_LEVEL=info
# 演示数据：用户 demo/demo1234、admin/admin1234，秒杀券 + 常驻券。仅限开发。
CK_SEED_DEMO=true

# --- PostgreSQL（compose 的 postgres 容器，宿主机端口 5433）----------------------
POSTGRES_USER=couponkill
POSTGRES_PASSWORD=couponkill
POSTGRES_DB=couponkill
# 宿主机进程用（scripts/dev-up.ps1、go run）：
CK_PG_DSN=postgres://couponkill:couponkill@127.0.0.1:5433/couponkill?sslmode=disable
# 容器内的服务用（--profile app）；通常不用改，改了 POSTGRES_* 时同步修改：
# CK_COMPOSE_PG_DSN=postgres://couponkill:couponkill@postgres:5432/couponkill?sslmode=disable

# --- Redis -------------------------------------------------------------------
CK_REDIS_ADDR=127.0.0.1:6379
CK_REDIS_PASSWORD=
CK_REDIS_DB=0

# --- Kafka（宿主机 listener；容器内的服务固定用 kafka:29092）--------------------
CK_KAFKA_BROKERS=127.0.0.1:9092
# seckill_order_create 的分区数 = order 消费者并行度上限；死信主题 seckill_order_create_dlt 的分区数
KAFKA_ORDER_PARTITIONS=16
KAFKA_DLT_PARTITIONS=4

# --- 登录令牌与服务间信任（≥32 字节 / ≥16 字节）--------------------------------
CK_JWT_SECRET=dev-only-jwt-secret-do-not-use-in-prod-0123456789
CK_JWT_ISSUER=couponkill
CK_JWT_AUDIENCE=couponkill-api
CK_JWT_TTL=24h
# 服务间内部接口（/internal/v1/*）的 X-Internal-Token
CK_INTERNAL_TOKEN=dev-only-internal-token-do-not-use-in-prod
# 网关给身份头签名（HMAC-SHA256）的密钥，下游服务用它验签
CK_GATEWAY_SIGN_KEY=dev-only-gateway-sign-key-do-not-use-in-prod-0123456789

# --- 服务地址（宿主机进程用；容器内由 compose 固定为服务名）-----------------------
CK_USER_URL=http://127.0.0.1:8081
CK_COUPON_URL=http://127.0.0.1:8080
CK_ORDER_URL=http://127.0.0.1:8082
CK_CONNECTOR_URL=http://127.0.0.1:8085

# --- 各服务私有开关（留空/注释 = 服务内置默认值）---------------------------------
# gateway：允许的前端 Origin（逗号分隔，不能是 *）；限流（每秒令牌数）；是否信任 X-Forwarded-For 的代理 CIDR
# CK_GATEWAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CK_GATEWAY_IP_RPS=50
# CK_GATEWAY_USER_RPS=20
# CK_GATEWAY_SECKILL_RPS=2
# CK_GATEWAY_TRUSTED_PROXIES=
# CK_GATEWAY_REVOCATION_FAIL_OPEN=true
# coupon：库存分桶数
# CK_COUPON_STOCK_BUCKETS=8
# order：秒杀冷却时间（0s = 关闭）
# CK_ORDER_SECKILL_COOLDOWN=0s

# --- connector 电商平台凭证（缺凭证的平台自动禁用；变量名见 internal/connector/config.go）--
# CK_CONNECTOR_JD_APP_KEY=
# CK_CONNECTOR_JD_APP_SECRET=
# CK_CONNECTOR_JD_ACCESS_TOKEN=
# CK_CONNECTOR_TB_APP_KEY=
# CK_CONNECTOR_TB_APP_SECRET=
# CK_CONNECTOR_TB_SESSION=
# CK_CONNECTOR_PDD_APP_KEY=
# CK_CONNECTOR_PDD_APP_SECRET=
# CK_CONNECTOR_PDD_ACCESS_TOKEN=

# --- 端到端测试 / 压测脚本（scripts/e2e.ps1、scripts/loadtest.ps1）-------------------
CK_E2E_BASE_URL=http://127.0.0.1:8088
