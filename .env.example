# 本地联调占位（复制为 .env 后按需修改；.env 已 gitignore）
# docker compose -f docker-compose.migration.yml 会读取同目录 .env

# 本地 PostgreSQL（与官方 postgres 镜像常见演示口令一致，禁止用于生产）
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres

# Nacos 3.x：即便 NACOS_AUTH_ENABLE=false 也需要占位 token（原文 ≥32 字符后再 Base64）
# 下面是本地演示值，生产必须换成自己的随机值
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=couponkill
NACOS_AUTH_IDENTITY_VALUE=couponkillLocal

# 应用侧（Java / Go / Helm Secret 同源）
JWT_SECRET=
CONNECTOR_INTERNAL_TOKEN=
CONNECTOR_ADMIN_TOKEN=
JD_APP_KEY=
JD_APP_SECRET=
JD_ACCESS_TOKEN=
